<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chauphan.triage-merge</string>
  <key>ProgramArguments</key>
  <array><string>/Users/chauphan/Developer/recense/sync/bin/triage-merge.zsh</string><string>run</string></array>
  <!-- hourly: merges one ready triage fixer branch if every gate passes (no AI) -->
  <key>StartInterval</key><integer>3600</integer>
  <key>ThrottleInterval</key><integer>10</integer>
  <!-- the fixer outlives this job: launchd must not kill its process group (T-0001) -->
  <key>AbandonProcessGroup</key><true/>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/Users/chauphan/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>/Users/chauphan/Library/Logs/triage-merge.log</string>
  <key>StandardErrorPath</key><string>/Users/chauphan/Library/Logs/triage-merge.log</string>
</dict>
</plist>
