<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chauphan.resign-ios</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>/Users/chauphan/Developer/sync/bin/resign-ios.zsh</string></array>
  <!-- daily at noon (and at the next wake if the Mac slept through it); the script re-signs only when 2 days or less are left -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/chauphan/Library/Logs/resign-ios.log</string>
  <key>StandardErrorPath</key><string>/Users/chauphan/Library/Logs/resign-ios.log</string>
</dict>
</plist>
