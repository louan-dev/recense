<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chauphan.archive-mount</string>
  <key>ProgramArguments</key>
  <array><string>/Users/chauphan/Developer/sync/bin/archive-mount.zsh</string></array>
  <!-- always on: up at login, back up if rclone exits (sleep, Wi-Fi loss, crash) -->
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/Users/chauphan/Library/Logs/archive-mount.log</string>
  <key>StandardErrorPath</key><string>/Users/chauphan/Library/Logs/archive-mount.log</string>
</dict>
</plist>
