<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chauphan.ledger.obsidian</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Developer/recense/sync/bin/ledger-job.sh</string>
    <string>__HOME__/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian</string>
    <string>rclone:gallery-main:gallery-main/ledger/obsidian</string>
    <string>obsidian</string>
  </array>
  <!-- event-driven: top-level vault changes (WatchPaths is not recursive; the daily heartbeat catches the rest) -->
  <key>WatchPaths</key><array><string>__HOME__/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>LowPriorityIO</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/ledger-obsidian.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/ledger-obsidian.log</string>
</dict>
</plist>
