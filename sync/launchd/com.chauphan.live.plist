<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chauphan.live</string>
  <key>ProgramArguments</key>
  <array><string>/Users/chauphan/Developer/recense/sync/bin/live.zsh</string><string>watch</string></array>
  <!-- FEAT-39: one long-running process, woken by FSEvents (fs.watch recursive); idle between saves, no timer, no polling -->
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/Users/chauphan/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>/Users/chauphan/Library/Logs/live.log</string>
  <key>StandardErrorPath</key><string>/Users/chauphan/Library/Logs/live.log</string>
</dict>
</plist>
