# docs-sync.zsh filters for the Obsidian vault: the same list plus the pictures notes embed.
# docs-sync.zsh filters (rclone filter syntax, first match wins). Documents only: writing, reading, forms,
# recordings; no programs, code, app data or hidden files. Changing this file makes the next pass a --resync.

# never: hidden files and folders, app/build/cache folders, things kept elsewhere
- .*
- .*/**
- node_modules/**
- worktrees/**
- DerivedData/**
- Library/**
- *.app/**
- *-handoff.zip
- ~$*
# names the Worker refuses (leading or trailing space): one would abort the whole folder
- {{(^|/) [^/]*$}}
- {{[^/]* $}}
- sandisk-rescue/to-archive/**
- auto_avsr/**
- Photos Library.photoslibrary/**

# writing and reading
+ *.{md,markdown,txt,rtf,tex}
+ *.{pdf,epub}
+ *.{docx,doc,odt,pages}
+ *.{xlsx,xls,ods,numbers,csv,tsv}
+ *.{pptx,ppt,odp,key}
+ *.canvas
# recordings
+ *.{m4a,mp3,wav,caf,aiff,aac,qta}
# pictures notes embed
+ *.{png,jpg,jpeg,gif,webp,heic,svg}
- *
