<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the Recense login item. Do not copy this file into LaunchAgents by hand:
  scripts/install-launchagent.sh fills in __RECENSE_BIN__ and __RECENSE_LOG__ with your real paths.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.recense</string>

    <key>ProgramArguments</key>
    <array>
        <string>__RECENSE_BIN__</string>
        <string>background</string>
    </array>

    <!-- Lets System Settings → Login Items list this as "Recense". -->
    <key>AssociatedBundleIdentifiers</key>
    <string>local.recense</string>

    <!-- Start once when you log in. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Start again after a crash (R15: an idle-time crash on 11-03 and 11-04 left Recense closed until reopened by hand).
         Only a crash: "recense quit" (exit 0) and pkill (SIGTERM) stay quit. Tested 2026-11-05: launchd restarts a job
         killed by SIGTRAP, the signal of Swift's runtime traps, and leaves one killed by SIGTERM alone. -->
    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- Only inside a normal graphical login session. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__RECENSE_LOG__</string>
    <key>StandardErrorPath</key>
    <string>__RECENSE_LOG__</string>
</dict>
</plist>
